{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/explain-before-approve"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)"
    ],
    "deny": [
      "Bash(git push* --force*)",
      "Bash(git push* -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean* -f*)",
      "Bash(git branch -D*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Bash(rm -rf /)",
      "Bash(rm -rf --no-preserve-root*)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm *)",
      "Bash(mkfs*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(chmod -R 777 /*)",
      "Bash(git push* --mirror*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(dd *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(killall*)",
      "Bash(pkill*)",
      "Bash(systemctl*)",
      "Bash(crontab*)",
      "Bash(git push*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker rm -f*)",
      "Bash(kubectl delete*)",
      "Bash(helm uninstall*)",
      "Bash(helm delete*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(npm publish*)",
      "Bash(uv publish*)",
      "Bash(twine upload*)",
      "Edit(//etc/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.py rtk hook claude"
          },
          {
            "type": "command",
            "command": "~/.claude/skills/github-push/preflight.py --hook",
            "if": "Bash(git push*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-python.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Deleting or overwriting files outside the current working directory",
      "Rewriting published git history, or any push that is not a fast-forward",
      "Destroying or recreating remote infrastructure, containers, volumes, or cluster resources",
      "Publishing a package, release, or artifact to a public registry"
    ],
    "hard_deny": [
      "$defaults",
      "Reading or exfiltrating SSH private keys, Claude credentials, or .env secrets",
      "Disabling, weakening, or editing these permission rules or the auto-mode classifier config"
    ],
    "classifyAllShell": true
  }
}
