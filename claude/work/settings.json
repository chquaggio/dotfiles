{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(/home/dev/Allianz/allianz_migration/outputs/**)",
      "Edit(/home/dev/Allianz/allianz_migration/outputs/**)",
      "Write(/home/dev/Allianz/allianz_migration/.claude/**)",
      "Edit(/home/dev/Allianz/allianz_migration/.claude/**)",
      "Write(/home/dev/Allianz/allianz_migration/CLAUDE.md)",
      "Edit(/home/dev/Allianz/allianz_migration/CLAUDE.md)",
      "Write(/home/dev/Allianz/allianz_migration/CHANGELOG.md)",
      "Edit(/home/dev/Allianz/allianz_migration/CHANGELOG.md)"
    ],
    "deny": [
      "Bash(git push* --force*)",
      "Bash(git push* -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean* -f*)",
      "Bash(git branch -D*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)"
    ],
    "defaultMode": "plan"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-python.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true
}
